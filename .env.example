# Maxima MCP Server configuration
# Copy to .env and adjust. All variables are optional.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# stdio (default) or http
MAXIMA_MCP_TRANSPORT=stdio

# HTTP only:
MAXIMA_MCP_HOST=127.0.0.1
MAXIMA_MCP_PORT=7331
# Strongly recommended whenever /mcp is reachable by anything other than you.
# MAXIMA_MCP_AUTH_TOKEN=replace-with-a-long-random-token
MAXIMA_MCP_CORS_ORIGINS=*
# Comma-separated allowed Host headers. Defaults to loopback values.
# MAXIMA_MCP_ALLOWED_HOSTS=mcp.example.com
MAXIMA_MCP_RATE_LIMIT=120
MAXIMA_MCP_RATE_WINDOW_MS=60000
MAXIMA_MCP_BODY_LIMIT=2mb
MAXIMA_MCP_JSON_RESPONSE=false
MAXIMA_MCP_TRUST_PROXY=false
MAXIMA_MCP_HTTP_SESSION_IDLE_MS=1800000

# ---------------------------------------------------------------------------
# Maxima executable and sessions
# ---------------------------------------------------------------------------
MAXIMA_BIN=maxima
# Extra CLI args, separated by ";;" or newlines.
# MAXIMA_MCP_EXTRA_ARGS=--lisp=acl
# Extra Maxima init statements, separated by ";;" or newlines.
# MAXIMA_MCP_INIT=assume(x > 0)$
MAXIMA_MCP_DEFAULT_TIMEOUT_MS=30000
MAXIMA_MCP_MAX_TIMEOUT_MS=300000
MAXIMA_MCP_MAX_OUTPUT_BYTES=1000000
# Per-process memory ceiling (MiB). 0 disables the watchdog. When exceeded, the
# Maxima process is killed and the session restarts on the next call.
MAXIMA_MCP_MAX_MEMORY_MB=0
MAXIMA_MCP_MAX_OUTPUT_CHARS=200000
MAXIMA_MCP_MAX_EXPRESSION_CHARS=100000
MAXIMA_MCP_MAX_COMMANDS=50
MAXIMA_MCP_MAX_PLOT_BYTES=10000000
MAXIMA_MCP_MAX_SESSIONS=8
MAXIMA_MCP_SESSION_IDLE_MS=900000
MAXIMA_MCP_DEFAULT_SESSION=default
MAXIMA_MCP_ALLOW_DANGEROUS=false
# MAXIMA_MCP_USERDIR=/var/cache/maxima-mcp/maxima-user
MAXIMA_MCP_CACHE_DIR=~/.cache/maxima-mcp

# ---------------------------------------------------------------------------
# Documentation and source indexes
# ---------------------------------------------------------------------------
MAXIMA_MCP_DOCS=true
MAXIMA_MCP_DOCS_PREWARM=true
MAXIMA_MCP_DOC_DIR=/usr/share/doc/maxima-doc/html
# Auto-detected from /usr/share/maxima/<version> when empty.
# MAXIMA_MCP_SRC_DIR=/usr/share/maxima/5.49.0/src
# MAXIMA_MCP_SHARE_DIR=/usr/share/maxima/5.49.0/share
MAXIMA_MCP_MAX_SEARCH_RESULTS=20
# Byte budget for the in-memory source file content cache. 0 disables it.
MAXIMA_MCP_SOURCE_CACHE_BYTES=67108864

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
MAXIMA_MCP_LOG_LEVEL=info
# json, pretty, or auto (pretty on a TTY, JSON otherwise)
MAXIMA_MCP_LOG_FORMAT=auto

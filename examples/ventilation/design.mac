/* ------------------------------------------------------------------
   VAV supply-air duct system and fan selection
   Case C: mid-rise office floor, Denver altitude, ASHRAE 62.1 / 90.1
   ------------------------------------------------------------------
   Run with:  maxima -b design.mac
   Units:     m, m3/s, Pa, W, K, kg/m3
   ------------------------------------------------------------------
   Preliminary design aid. Not a substitute for a stamped HVAC design,
   manufacturer's fan selection software, or a full ASHRAE 90.1
   compliance analysis.
   ------------------------------------------------------------------ */

kill(all)$

/* ---------- 1. Air properties and design airflow ----------------- */

L10(x) := log(x)/log(10.0)$

rho : 1.0086$        /* kg/m3, Denver 1610 m at 15 C supply      */
cp  : 1005$          /* J/(kg K)                                 */
mu  : 1.81e-5$       /* Pa s, air at 15 C                        */
eps : 0.09e-3$       /* m, galvanised steel roughness            */

Qcool : 48000$       /* W, sensible room load                    */
dT    : 12.0$        /* K, supply-to-room temperature difference */

Vdot : Qcool/(rho*cp*dT)$
mdot : rho*Vdot$

/* ASHRAE 62.1 office ventilation: Rp = 2.5 L/s per person,
   Ra = 0.3 L/s per m2. 60 people, 600 m2.                    */
P_people : 60$
A_floor  : 600$
Vbz      : P_people*2.5 + A_floor*0.3$     /* L/s */
Vvent    : Vbz/1000$                        /* m3/s */
OA_frac  : Vvent/Vdot$

/* ---------- 2. Duct friction (Colebrook and Swamee-Jain) --------- */

fc(Re,eD) := block([f],
  f : find_root(1/sqrt(f) + 2*L10(eD/3.7 + 2.51/(Re*sqrt(f))) = 0,
                f, 1e-4, 0.2),
  f)$

fsj(Re,eD) := 0.25/(L10(eD/3.7 + 5.74/Re^0.9))^2$

/* rectangular segment: Q, width, height, length, sum(K) */
segrect(Q,a,b,L,K) := block(
  [A,P,Dh,V,Re,f,dyn,dpf,dpk],
  A  : a*b,
  P  : 2*(a+b),
  Dh : 4*A/P,
  V  : Q/A,
  Re : rho*V*Dh/mu,
  f  : fc(Re, eps/Dh),
  dyn: rho*V^2/2,
  dpf: f*L/Dh*dyn,
  dpk: K*dyn,
  [A,Dh,V,Re,f,dpf,dpk,dpf+dpk])$

/* circular segment: Q, diameter, length, sum(K) */
segcirc(Q,d,L,K) := block(
  [A,Dh,V,Re,f,dyn,dpf,dpk],
  A  : %pi*d^2/4,
  Dh : d,
  V  : Q/A,
  Re : rho*V*Dh/mu,
  f  : fc(Re, eps/Dh),
  dyn: rho*V^2/2,
  dpf: f*L/Dh*dyn,
  dpk: K*dyn,
  [A,Dh,V,Re,f,dpf,dpk,dpf+dpk])$

/* Index run: [Q, width, height, length, sum(K)] */
segs : [
  [4.00, 1.20, 0.60,  8.0, 0.40],   /* AHU discharge + transition + elbow */
  [4.00, 1.10, 0.60, 20.0, 0.55],   /* main trunk, elbow + straight tee   */
  [2.75, 0.90, 0.55, 12.0, 0.60],   /* trunk after take-off, wye + elbow  */
  [1.60, 0.75, 0.45, 12.0, 0.85],   /* branch, two elbows + wye           */
  [0.80, 0.55, 0.40,  9.0, 0.35]    /* run-out, elbow + transition        */
]$

dp_duct : 0$
fmaxdiff : 0$
dp_sj : 0$

for i:1 thru length(segs) do block(
  [s:segs[i], r, rsj, A,P,Dh,V,Re,fs,fj,dyn,dpf,dpk,diff],
  r   : segrect(s[1],s[2],s[3],s[4],s[5]),
  dp_duct : dp_duct + r[8],
  A   : s[2]*s[3],
  P   : 2*(s[2]+s[3]),
  Dh  : 4*A/P,
  V   : s[1]/A,
  Re  : rho*V*Dh/mu,
  fs  : fc(Re,eps/Dh),
  fj  : fsj(Re,eps/Dh),
  dyn : rho*V^2/2,
  dpf : fj*s[4]/Dh*dyn,
  dpk : s[5]*dyn,
  dp_sj : dp_sj + dpf + dpk,
  diff : abs(100*(fj-fs)/fs),
  if diff > fmaxdiff then fmaxdiff : diff,
  print("seg",i,"  V =",float(V),"  f =",float(fs),
        "  dp =",float(r[8])))$

/* VAV box run-out: 6 m of 450 mm flexible duct, two 90 deg bends */
rf : segcirc(0.80, 0.45, 6.0, 1.20)$
dp_duct : dp_duct + rf[8]$

Asj : %pi*0.45^2/4$
Vsj : 0.80/Asj$
Resj: rho*Vsj*0.45/mu$
dpsj_flex : fsj(Resj,eps/0.45)*6.0/0.45*(rho*Vsj^2/2)
            + 1.20*(rho*Vsj^2/2)$
dp_sj : dp_sj + dpsj_flex$

/* ---------- 3. AHU internals, terminal and fan duty -------------- */

dp_louver   : 30$    /* outside-air louver and plenum        */
dp_pre      : 120$   /* MERV 8 pre-filter, dirty             */
dp_final    : 250$   /* MERV 13 final filter, dirty          */
dp_coil     : 180$   /* cooling coil, wet                    */
dp_heat     : 40$    /* heating coil                         */
dp_econ     : 40$    /* economiser dampers                   */
dp_fandisch : 30$    /* fan discharge and transition          */

dp_ahu  : dp_louver+dp_pre+dp_final+dp_coil+dp_heat+dp_econ+dp_fandisch$
dp_vav  : 100$       /* VAV terminal, catalog at design flow */
dp_diff : 40$        /* diffuser                              */
dp_term : dp_vav+dp_diff$

dp_raw : dp_duct + dp_ahu + dp_term$
dp_sys : dp_raw*1.10$        /* 10 % design margin, calculated */
dp_sel : 1000.0$             /* rounded-up fan static duty     */

Qd  : 4.00$                  /* selected design airflow, m3/s */
eta_f : 0.72$                /* fan total efficiency          */
eta_m : 0.90$                /* motor efficiency              */

P_air   : Qd*dp_sel$
P_shaft : P_air/eta_f$
P_input : P_shaft/eta_m$

/* ---------- 4. Altitude correction to catalog duty -------------- */

rho_std     : 1.2$
dp_catalog  : dp_sel*rho_std/rho$
P_shaft_cat : Qd*dp_catalog/eta_f$

/* ---------- 5. ASHRAE 90.1 fan power check (SI, VAV) ------------ */

Lps     : Qd*1000$
allow1  : 0.0024*Lps$
PD_merv13 : 0.9*249.09$          /* 0.9 in w.g. credit, MERV 13-15 */
A_credit : PD_merv13*Lps/650000$
allow2  : 0.0021*Lps + A_credit$

/* ---------- 6. Duct heat gain ----------------------------------- */

A_duct : 2*(1.2+0.6)*8 + 2*(1.1+0.6)*20 + 2*(0.9+0.55)*12
         + 2*(0.75+0.45)*12 + 2*(0.55+0.4)*9 + %pi*0.45*6$
Q_gain  : 0.60*A_duct*(30-13)$      /* U = 0.60 W/m2K, 17 K */
dT_gain : Q_gain/(mdot*cp)$

/* ---------- 7. Fan / system operating points -------------------- */

k_d     : dp_sel/Qd^2$
dp0     : 1350.0$
a_f     : (dp0-dp_sel)/Qd^2$
Qop(k)  := sqrt(dp0/(k+a_f))$
k_clean : (dp_sel-190)/Qd^2$
k_dirty : (dp_sel+190)/Qd^2$

/* ---------- 8. Part-load fan energy ----------------------------- */

hours : [500,1000,1500,1500]$
frac  : [1.0,0.8,0.6,0.4]$
E_cv  : P_input/1000*sum(hours[i],i,1,4)$
E_vfd : P_input/1000*sum(hours[i]*frac[i]^3,i,1,4)$

/* ---------- 9. Report ------------------------------------------- */

print("")$
print("VAV supply-air system and fan selection")$
print("---------------------------------------------------------------")$
print("Air density at site [kg/m3]        :", float(rho))$
print("Sensible load [kW]                 :", float(Qcool/1000))$
print("Supply airflow required [m3/s]     :", float(Vdot))$
print("Design airflow selected [m3/s]     :", float(Qd))$
print("Ventilation airflow [L/s]          :", float(Vbz))$
print("Outdoor-air fraction [-]           :", float(OA_frac))$
print("")$
print("Index duct + fittings [Pa]         :", float(dp_duct))$
print("AHU internal losses [Pa]           :", float(dp_ahu))$
print("Terminal losses [Pa]               :", float(dp_term))$
print("System subtotal [Pa]               :", float(dp_raw))$
print("Design static, +10 % [Pa]          :", float(dp_sys))$
print("Selected fan static duty [Pa]      :", float(dp_sel))$
print("")$
print("Fan air power [kW]                 :", float(P_air/1000))$
print("Fan shaft power, site [kW]         :", float(P_shaft/1000))$
print("Motor input power [kW]             :", float(P_input/1000))$
print("Specific power [W/(L/s)]           :", float(P_input/(Qd*1000)))$
print("Catalog duty at standard air [Pa]  :", float(dp_catalog))$
print("Catalog shaft power [kW]           :", float(P_shaft_cat/1000))$
print("")$
print("90.1 Option 1 allowable [kW]       :", float(allow1))$
print("90.1 A credit [kW]                 :", float(A_credit))$
print("90.1 Option 2 allowable [kW]       :", float(allow2))$
print("Option 1 margin [%]                :", float(100*(allow1-7.5)/allow1))$
print("Option 2 margin [%]                :", float(100*(allow2-P_input/1000)/allow2))$
print("")$
print("Duct heat gain [kW]                :", float(Q_gain/1000))$
print("Supply temperature rise [K]        :", float(dT_gain))$
print("")$
print("Operating flow, clean filters       :", float(Qop(k_clean)))$
print("Operating flow, design              :", float(Qop(k_d)))$
print("Operating flow, dirty filters       :", float(Qop(k_dirty)))$
print("Dirty-filter flow deficit [%]       :", float(100*(Qd-Qop(k_dirty))/Qd))$
print("")$
print("Verification: max f difference [%]  :", float(fmaxdiff))$
print("Verification: pressure difference[%]:", float(100*(dp_sj-dp_duct)/dp_duct))$
print("")$
print("Constant-volume fan energy [kWh/yr] :", float(E_cv))$
print("VFD fan energy [kWh/yr]             :", float(E_vfd))$
print("Fan energy saving [%]               :", float(100*(E_cv-E_vfd)/E_cv))$
print("---------------------------------------------------------------")$
